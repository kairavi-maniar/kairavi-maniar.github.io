---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, projectCategories } from '../../data/projects';
---

<MainLayout title="Projects" description="Projects and case studies in archival research, construction history, digitisation, digital heritage, mapping, and public engagement.">
  <PageHead
    eyebrow="Projects"
    title="Projects and case studies"
    lede="Archival research, construction history, digitisation and preservation, mapping, and public engagement. Each project has its own case study."
    trail={[{ label: 'Projects' }]}
  />

  <section class="section" style="padding-top: 48px">
    <div class="wrap" data-filter-root>
      <div class="filterbar" role="group" aria-label="Filter projects by category">
        <button type="button" class="chip" data-filter="all" aria-pressed="true">All projects</button>
        {projectCategories.map((c) => <button type="button" class="chip" data-filter={c} aria-pressed="false">{c}</button>)}
      </div>
      <p class="filter-status" aria-live="polite" data-filter-status>Showing all {projects.length} projects.</p>
      <div class="grid grid--3" style="gap: 64px 40px">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter-root]');
  if (root) {
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = root.querySelectorAll<HTMLElement>('[data-categories]');
    const status = root.querySelector('[data-filter-status]');
    const apply = (f: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === f)));
      let n = 0;
      cards.forEach((card) => {
        const show = f === 'all' || (card.dataset.categories ?? '').split('|').includes(f);
        card.hidden = !show;
        if (show) n++;
      });
      if (status) status.textContent = f === 'all' ? `Showing all ${n} projects.` : `Showing ${n} ${n === 1 ? 'project' : 'projects'} in ${f}.`;
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter ?? 'all')));
    const fromHash = decodeURIComponent(location.hash.slice(1));
    if (fromHash && Array.from(chips).some((c) => c.dataset.filter === fromHash)) apply(fromHash);
  }
</script>
